# SDLC 平台环境变量样例（拷为 .env 后按需修改；前缀 SDLC_，pydantic-settings 读仓根 .env）
# MySQL 数据源（必填——空串启动即报错带指引，不给静默默认）
# 本地开发：docker compose -f compose/mysql.dev.yml up -d 后用下面这行
SDLC_DB_DSN=mysql://root:sdlc@127.0.0.1:3306/sdlc

# 进程内 agent（openai-agents，任意 OpenAI 兼容端点；不配则任务不自动执行）
SDLC_AGENT_ENABLED=true
SDLC_AGENT_BASE_URL=
SDLC_AGENT_MODEL=
SDLC_AGENT_API_KEY=
# 技能仓（规范素材 + 确定性脚本；版本须 ≥ 2026-10-28，feishu_fetch 启动探测）
SDLC_AGENT_SKILLS_REPO=~/IdeaProjects/claude-sdlc-skills
SDLC_AGENT_WORKSPACE_ROOT=.

# 飞书应用凭据（留空 = 无飞书能力：feishu_fetch 不注册/飞书源明确失败/白名单无 lark-cli 三处联动）
SDLC_FEISHU_APP_ID=
SDLC_FEISHU_APP_SECRET=
SDLC_FEISHU_MEDIA_MAX_BYTES=10485760

# 写防护（设置后非 GET 的 /api 写接口要求 X-Token 头；内网部署建议启用）
SDLC_WRITE_TOKEN=

# 其余（一般无需改）：SDLC_PORT=8888 / SDLC_MEDIA_DIR=./data/media /
#   SDLC_AGENT_TIMEOUT_MIN=30 / SDLC_AGENT_MAX_ITERS=160 / SDLC_AGENT_POLL_INTERVAL_MS=3000 /
#   SDLC_GATE_TIMEOUT_MIN=60
