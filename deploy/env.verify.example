# 本地容器验证栈专用 env（compose/server.verify.yml 配套，2026-10-30 起 baked 进镜像）。
# DSN 指向 compose 栈内 mysql 服务名——server.verify.yml 不再注入 DSN/AGENT_ENABLED，
# 起栈即验证「配置在镜像里」通道真实生效。
# 用法：cp deploy/env.verify.example deploy/env.verify → ENV_FILE=deploy/env.verify deploy/build.sh
# （本文件若填了真实 agent 三元组，deploy/env.verify 同样不入库；密钥推荐经宿主 env 透传而非打进验证镜像）
SDLC_DB_DSN=mysql://root:sdlc@mysql:3306/sdlc
SDLC_AGENT_ENABLED=true
SDLC_AGENT_BASE_URL=
SDLC_AGENT_MODEL=
SDLC_AGENT_API_KEY=
