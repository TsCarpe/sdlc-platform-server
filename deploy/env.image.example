# 容器镜像配置模板（2026-10-30 目标收窄：配置构建期打进镜像 → /opt/app/.env，pydantic-settings 直读；
# 运行期环境变量仍可覆盖文件值——排障/临时切换用）。
# 用法：拷为 deploy/env.image 填真值（已 gitignore，绝不入库）→ deploy/build.sh 默认拾取。
# ⚠ 密钥（DSN 密码 / API_KEY / 写令牌 / 飞书 secret）将进镜像层——内网开发环境既定取舍，镜像勿推公网仓库。
# ⚠ 路径类（SDLC_AGENT_SKILLS_REPO / SDLC_MEDIA_DIR / SDLC_AGENT_WORKSPACE_ROOT）已由镜像 ENV 固化
#   （/opt/app/skills、/data/media、/data/ws），此处配置不生效——环境变量优先于 env 文件。

# MySQL 数据源（必填——空串启动即报错；密码特殊字符必须 URL 百分号编码，未编码会静默连错库/连不上）
SDLC_DB_DSN=mysql://user:pass@host:3306/sdlc

# 进程内 agent（openai-agents，任意 OpenAI 兼容端点；不开启则任务不自动执行——构建期仅警告不阻断）
SDLC_AGENT_ENABLED=true
SDLC_AGENT_BASE_URL=
SDLC_AGENT_MODEL=
SDLC_AGENT_API_KEY=

# 飞书应用凭据（留空 = 无飞书能力：feishu_fetch 不注册/飞书源明确失败/白名单无 lark-cli 三处联动）
SDLC_FEISHU_APP_ID=
SDLC_FEISHU_APP_SECRET=

# 写防护（设置后非 GET 的 /api 写接口要求 X-Token 头；注意 verify 黑盒脚本族无 X-Token 通道）
SDLC_WRITE_TOKEN=
